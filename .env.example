# ---------------------------------------------------------------------------
# Mamma Mia Restaurant & Lounge — environment configuration
#
# Copy this file to `.env.local` and fill in the real values.
# Every variable below is OPTIONAL: the site is designed to work without them
# and shows an honest "ask us" / "coming soon" state instead of inventing data.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://mammamiahurghada.com

# WhatsApp chat. Defaults to +201208185554 if left empty.
# "Book your table" opens this chat with a reservation message.
# The WhatsApp icon/button opens the same chat without preset text.
# Format: https://wa.me/<country code><number>
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/201208185554

# Google Maps link for the venue (opens the Google Maps app / site).
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.app.goo.gl/BmBzNsxaaLhzk6VK6

# Optional custom embed URL for the on-page map. Defaults to the venue pin.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Official TikTok profile. Defaults to @mammamiahurghada if left empty.
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@mammamiahurghada

# Official Snapchat profile URL. The handle (Mammamia_hrg) is always displayed;
# it only becomes a link once this is set.
NEXT_PUBLIC_SNAPCHAT_URL=

# Optional direct contact details shown in the contact section.
NEXT_PUBLIC_CONTACT_PHONE=+201208185554
NEXT_PUBLIC_CONTACT_EMAIL=

# Admin (/admin) — events manager
# Defaults in code: user Ewen / password Mag-60740 (override here in production)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional stronger session signing secret
# ADMIN_SESSION_SECRET=

# Required on Vercel so event text/images persist between deploys.
# Create a Blob store in the Vercel dashboard, then paste the token here.
# BLOB_READ_WRITE_TOKEN=
